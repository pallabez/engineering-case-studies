---
interface Props { title: string; description: string; image?: string; }
const { title, description, image = 'og/subscriptions.jpg' } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(base + image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {import.meta.env.PROD && (
      <script is:inline async data-goatcounter="https://pallab.goatcounter.com/count" src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body><slot /></body>
</html>
