---
import BaseLayout from '../layouts/BaseLayout.astro';
import { caseStudies } from '../data/case-studies';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Engineering case studies · Pallab" description="Interactive stories about the systems I build, the decisions behind them, and how they work.">
  <main>
    <header><a href={base} class="byline">pallab<span>/</span>fyi</a><span>CASE STUDIES</span></header>
    <section class="intro" aria-labelledby="title"><p class="eyebrow">THE DECISIONS BEHIND THE SYSTEMS</p><h1 id="title">Built. Questioned.<br /><em>Explained.</em></h1><p class="lede">Stories from the systems I build.<br />Follow the decisions. Move the pieces. See what changes.</p></section>
    <section class="studies" aria-label="Case studies">
      {caseStudies.map((study, i) => <a class="study" href={`${base}stories/${study.slug}/`}>
        <div class="art"><img src={`${base}${study.image}`} alt="" width="1672" height="941" loading={i === 0 ? 'eager' : 'lazy'} /><span class="number">{String(i + 1).padStart(2, '0')}</span></div>
        <div class="study-copy"><p class="topics">{study.topics.join(' / ')}</p><h2>{study.title}</h2><p class="question">{study.question}</p><p class="description">{study.description}</p><span class="open">Explore the story <span aria-hidden="true">↗</span></span></div>
      </a>)}
    </section>
    <footer>Written and built by Pallab.</footer>
  </main>
</BaseLayout>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap');
*{box-sizing:border-box}body{margin:0;background:#080b10;color:#f1eadf;font-family:'DM Sans',system-ui,sans-serif}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid #ffb168;outline-offset:10px}main{max-width:1480px;margin:auto;padding:0 6%}header{display:flex;justify-content:space-between;gap:24px;padding:36px 0;font-size:12px;letter-spacing:.1em}header>span{color:#979fa9}.byline{font-size:14px;letter-spacing:.04em}.byline span{color:#ffb168}.intro{padding:85px 0 70px}.eyebrow{font-size:11px;letter-spacing:.16em;color:#bcb2a6}h1{font-family:'Instrument Serif',Georgia,serif;font-weight:400;font-size:clamp(65px,8vw,118px);line-height:.98;letter-spacing:-.035em;margin:28px 0}em{color:#ffb168;font-weight:400}.lede{color:#aeb4bd;line-height:1.75;font-size:17px}.study{display:grid;grid-template-columns:1.25fr 1fr;gap:6%;align-items:center;padding:40px 0 65px;border-top:1px solid #ffffff24}.art{position:relative;overflow:hidden;aspect-ratio:1.6;background:#101820}.art img{width:100%;height:100%;object-fit:cover;opacity:.8;transition:transform .7s,opacity .7s}.study:hover img{transform:scale(1.035);opacity:1}.number{position:absolute;left:22px;top:20px;font-size:12px;letter-spacing:.1em}.topics{color:#b7a48e;font-size:11px;letter-spacing:.08em;line-height:1.8}h2{font-family:'Instrument Serif',Georgia,serif;font-size:clamp(40px,4vw,62px);font-weight:400;line-height:1.04;margin:20px 0}.question{font-size:17px;line-height:1.6}.description{color:#9da7b3;font-size:15px;line-height:1.7;max-width:380px}.open{display:flex;justify-content:space-between;max-width:210px;margin-top:32px;padding-bottom:12px;border-bottom:1px solid #9c7653;font-size:14px}.open>span{color:#ffb168}footer{padding:35px 0;border-top:1px solid #ffffff24;font-size:12px;color:#959eaa}@media(max-width:650px){header{font-size:10px;padding:25px 0}.eyebrow,.description{display:none}.intro{padding:50px 0 45px}h1{font-size:70px}.lede{font-size:15px}.study{grid-template-columns:1fr;gap:25px;padding-top:25px}.art{aspect-ratio:1.65}.study-copy{padding-bottom:20px}h2{font-size:43px}.topics{font-size:10px}.question{font-size:16px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
